APP_NAME=PolicyFlow
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# --- Database -------------------------------------------------------------
# Default: MySQL 8+. Create the database first:  CREATE DATABASE policyflow CHARACTER SET utf8mb4;
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=policyflow
DB_USERNAME=root
DB_PASSWORD=
# Zero-install alternative: use SQLite instead (comment out the DB_* lines above and use these two):
# DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite   (create the empty file first)

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

# --- Mock insurer / issuance (development only) ----------------------------
INSURER_MAX_ATTEMPTS=3
INSURER_STALE_SUBMITTED_SECONDS=300
INSURER_STALE_PENDING_SECONDS=900
INSURER_RECONCILE_INLINE=true
INSURER_ALLOW_SCENARIO_OVERRIDE=true
MOCK_INSURER_CONTROLS=true
